# ---- copy to .env (local) or paste these as environment variables on your host ----

# First admin login. Used only when the database has no admin user yet.
ADMIN_USERNAME=gflo
ADMIN_PASSWORD=change-this-to-something-long

# Signs the admin session cookie. Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
# If unset, a secret is generated and stored in DATA_DIR — fine for a single instance.
SECRET_KEY=

# Where the SQLite file and uploaded photos live.
# On Render/Northflank point this at your mounted volume, e.g. /data
DATA_DIR=./data

# Folder holding gflo.html (the storefront). Defaults to ../site
# SITE_DIR=/site

# Optional: use Postgres instead of SQLite
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/gflo

# Optional: how long an admin stays signed in (seconds) and lockout tuning
# SESSION_MAX_AGE=43200
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_LOCKOUT_SECONDS=900

# ---- proxy / rate-limit trust ----
# Only set these when the app really sits behind a reverse proxy. TRUSTED_PROXIES
# is the proxy address(es)/CIDRs whose X-Forwarded-For the app will believe when
# deciding the client IP for login rate limiting; FORWARDED_ALLOW_IPS is the
# matching uvicorn flag. Leave both unset when the app is directly exposed —
# otherwise any client can spoof its IP and bypass the login lockout.
# TRUSTED_PROXIES=10.0.0.1
# FORWARDED_ALLOW_IPS=10.0.0.1

# Force the Secure flag on admin cookies (recommended for any HTTPS deployment)
# COOKIE_SECURE=true

# Expose the interactive API docs at /api/docs (off by default)
# ENABLE_DOCS=false

# ---- Sentry (error monitoring) ----
# Paste the DSN from your Sentry project (Settings -> Client Keys). Leave it
# unset and error monitoring stays off — nothing else changes.
SENTRY_DSN=
# Shown as the environment tag in Sentry. Use "production" on your live host.
SENTRY_ENVIRONMENT=development
# Fraction of requests traced for performance (0 = off, 0.1 = 10%). Traces are
# billed by Sentry, so keep this low.
SENTRY_TRACES_SAMPLE_RATE=0
# Optional: tag events with the running version/commit
# SENTRY_RELEASE=

# Force the Secure flag on admin cookies (recommended for any HTTPS deployment)
# COOKIE_SECURE=true

# Expose the interactive API docs at /api/docs (off by default)
# ENABLE_DOCS=false
